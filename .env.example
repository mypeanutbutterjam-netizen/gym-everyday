# Public Google OAuth Web Client ID (authorized JS origins: official GitHub Pages + localhost).
# The public site build does not set this, so Google sign-in stays off.
VITE_GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com

# VITE_SYNC_API — origin of the dedicated sync Worker (no path, no trailing slash).
# Leave empty until that Worker is deployed. Example:
# VITE_SYNC_API=https://YOUR-DEDICATED-SYNC.example
VITE_SYNC_API=

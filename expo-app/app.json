{
  "expo": {
    "name": "Gym Everyday",
    "slug": "gym-everyday",
    "scheme": "gymeveryday",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "backgroundColor": "#0a0614",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.mypeanutbutterjam.gymeveryday",
      "config": {
        "usesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "com.mypeanutbutterjam.gymeveryday",
      "adaptiveIcon": {
        "backgroundColor": "#0a0614",
        "foregroundImage": "./assets/android-icon-foreground.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-web-browser",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#0a0614",
          "image": "./assets/splash-icon.png",
          "imageWidth": 200
        }
      ]
    ],
    "extra": {
      "siteUrl": "https://mypeanutbutterjam-netizen.github.io/gym-everyday/",
      "privacyPolicyUrl": "https://mypeanutbutterjam-netizen.github.io/gym-everyday/privacy.html"
    }
  }
}
